<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SCPM.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Lets the EF design-time factory read SCPM.Api's user secrets, so `dotnet ef` finds the
         same connection string the app uses. Not part of the shared framework, unlike the JSON
         and environment-variable providers it sits alongside. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <!-- AddHangfire/AddHangfireServer (the IServiceCollection extensions used below) live in
         Hangfire.AspNetCore, not Hangfire.Core — Api also references it for UseHangfireDashboard. -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.22.2" />
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- DOCX/PPTX generation. ClosedXML already depends on this transitively, but the exporter
         uses the SDK's own types directly, so the dependency is declared rather than inherited. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SCPM.Application\SCPM.Application.csproj" />
  </ItemGroup>

</Project>
